# Copy to configs/paths.env, fill in, and keep it out of version control.
PYTHON=/path/to/python
# checkout of github.com/alexzhang13/rlm at commit 854e688 (the agent loop of the snippet and document REPL agents)
RLMLIB_PATH=
# working directory of the document REPL agent: holds data/prepared (corpus, queries, qrels), data/indexes, data/models
FULLDOC_ROOT=
# checkout of OBLIQ-Bench data: <task>/<subset>/queries+qrels/{queries.jsonl,qrels.tsv}
OBLIQ_BENCH_ROOT=
# FRAMES question files (test.tsv, frames_rows.json) and the BM25 index of Wikipedia 20230601.en
FRAMES_DATA_DIR=
# BM25 index of the BrowseComp-Plus corpus (built by retrieval/bcp_build_bm25_default.py)
BCP_BM25_INDEX_DIR=
# where run outputs (per-question records, trajectories, grades) are written
RUNS_DIR=
# file defining AZ_EP (Azure OpenAI endpoint) and AZ_KEY (API key); never committed
AZ_ENV=
# Azure deployment serving gpt-5 (root model of the GPT-5 rows)
AZURE_DEPLOYMENT_GPT5=
# Azure deployment serving gpt-5.2 (OBLIQ rows)
AZURE_DEPLOYMENT_GPT52=
# Azure deployment serving gpt-4.1 (the judge of every BrowseComp+ and FRAMES row)
AZURE_DEPLOYMENT_JUDGE=
# root of the original run logs (logs/ of the original repository)
LOGS_ROOT=
# checkout of the original (internal) research repository; only the re-judging and reporting scripts read archived results from it
ORIGINAL_REPO_ROOT=
# checkout holding scripts/retrieval_eval.py (the PLAID build-and-evaluate script, not part of this repository); retrieval/build_bc_rmcb_dl8192.sh runs there and writes logs/ and .pylate_idx/ into it
RETRIEVAL_EVAL_ROOT=
# file in .env format holding the Vertex AI service-account JSON for Gemini-Embedding-2 (variable name as in retrieval/gemini/vertex.py); read only when that variable is not already in the environment; never committed
GCP_VERTEX_ENV=
