# Azure credentials for the agents and the judge. Copy to .secrets/x3.env (chmod 600) or set values with
# evaluation/x3_secret.sh set KEY. Aliases accepted by x3_env.py: AZ_EP, AZ_KEY, AZURE_DEPLOYMENT_GPT5, AZURE_DEPLOYMENT_JUDGE.
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=<key>
GPT5_DEPLOYMENT=<GPT-5 deployment name>
# Optional
# JUDGE_DEPLOYMENT=<gpt-4.1 deployment name; without it the GPT-5 deployment also judges>
# AZURE_OPENAI_API_VERSION=2025-04-01-preview
# X3_JUDGE_ENDPOINT=   # only if the judge is deployed on a different resource
# X3_JUDGE_API_KEY=
